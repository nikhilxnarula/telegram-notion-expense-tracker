# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# any long random string you invent; also passed to setWebhook
TELEGRAM_WEBHOOK_SECRET=
# comma-separated; your own chat_id from scripts/get_chat_id.py
ALLOWED_CHAT_IDS=

# --- Notion ---
NOTION_API_KEY=
# bare id, dashed UUID, or the whole database URL - all work
NOTION_DATABASE_ID=

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
# run scripts/list_models.py and paste a real one here.
# newer models need the inference-profile form, e.g. us.anthropic.claude-...
BEDROCK_MODEL_ID=

# Credentials are read by boto3 from the standard chain. Locally, prefer a
# shared profile (AWS_PROFILE=...) or `aws configure`. Only set explicit keys
# where no role is available - e.g. Cloud Run:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Misc ---
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=Rs
