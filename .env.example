# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# any long random string you invent; also passed to setWebhook
TELEGRAM_WEBHOOK_SECRET=
# comma-separated; your own chat_id from scripts/get_chat_id.py
ALLOWED_CHAT_IDS=

# --- Notion ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Gemini ---
GEMINI_API_KEY=
# run scripts/list_models.py and paste a real one here
GEMINI_MODEL=gemini-2.5-flash

# --- Misc ---
TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=Rs
